pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building the application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing the application...'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    echo "Starting deployment..."

                    scp -o StrictHostKeyChecking=no index.html likesy@192.168.56.101:/var/www/html/

                    echo "Deployment completed successfully."
                '''
            }
        }
    }
}
