pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh '''
                    echo "Starting build..."

                    if [ -f index.html ]; then
                        echo "index.html found."
                    else
                        echo "ERROR: index.html not found."
                        exit 1
                    fi

                    echo "Build completed successfully."
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "Starting tests..."

                    grep -q "Jenkins" index.html
                    echo "HTML content test passed."

                    echo "Tests completed successfully."
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "Building Docker image..."

                    docker build -t jenkins-demo:latest .

                    echo "Docker image built successfully."
                '''
            }
        }

        stage('Docker Deploy') {
            steps {
                sh '''
                    echo "Deploying Docker container..."

                    docker stop jenkins-demo-container || true
                    docker rm jenkins-demo-container || true

                    docker run -d \
                        -p 8081:80 \
                        --name jenkins-demo-container \
                        jenkins-demo:latest

                    echo "Docker container deployed successfully."
                '''
            }
        }
    }

    post {
        success {
            echo '🎉 Docker CI/CD pipeline completed successfully!'
        }

        failure {
            echo '❌ Pipeline failed. Check the failed stage and console log.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
