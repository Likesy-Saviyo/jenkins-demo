pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh '''
                    echo "Starting build..."

                    if [ -f index.html ]; then
                        echo "index.html found."
                    else
                        echo "ERROR: index.html not found."
                        exit 1
                    fi

                    echo "Build completed successfully."
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "Starting tests..."

                    grep -q "Jenkins" index.html
                    echo "HTML content test passed."

                    echo "Tests completed successfully."
                '''
            }
        }

       stage('Docker Compose Deploy') {
    steps {
        sh '''
            echo "Starting Docker Compose deployment..."

            echo "Saving current image..."
            OLD_IMAGE=$(docker image inspect jenkins-demo:latest --format '{{.Id}}')

            echo "Building new Docker image..."
            docker compose build

            echo "Starting new deployment..."
            docker compose up -d

            echo "Waiting for application..."
            sleep 5

            echo "Running health check..."

            if curl -f http://localhost:8082; then
                echo "Application health check passed."
                echo "New deployment is healthy."
            else
                echo "Health check failed!"
                echo "Rolling back to previous image..."

                docker compose down

                docker tag "$OLD_IMAGE" jenkins-demo:latest

                docker compose up -d

                echo "Rollback completed."
                exit 1
            fi

            echo "Docker Compose deployment completed successfully."
        '''
    }
}
    }

    post {

        success {
            echo '🎉 Docker Compose CI/CD pipeline completed successfully!'
        }

        failure {
            echo '❌ Pipeline failed. Check the failed stage and console log.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
