pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh '''
                    echo "Starting build..."

                    if [ -f index.html ]; then
                        echo "index.html found."
                    else
                        echo "ERROR: index.html not found."
                        exit 1
                    fi

                    echo "Build completed successfully."
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "Starting tests..."

                    grep -q "Jenkins" index.html
                    echo "HTML content test passed."

                    echo "Tests completed successfully."
                '''
            }
        }

        stage('Docker Compose Deploy') {
            steps {
                sh '''
                    echo "Starting Docker Compose deployment..."

                    docker compose down || true

                    docker compose up -d --build

                    echo "Docker Compose deployment completed successfully."
                '''
            }
        }
    }

    post {

        success {
            echo '🎉 Docker Compose CI/CD pipeline completed successfully!'
        }

        failure {
            echo '❌ Pipeline failed. Check the failed stage and console log.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
